{
  "name": "@onekey-locker/api",
  "version": "1.0.0",
  "description": "API server for OneKey Locker: stores ciphertext and checks signed updates. Hono and PostgreSQL.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@onekey-locker/crypto": "1.0.0",
    "hono": "4.13.13",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
