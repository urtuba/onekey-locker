generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlobStatus {
  active
  locked
  expired
  deleted
  suspended
}

enum BlobPlan {
  free
  premium
  enterprise
}

enum AccessOperation {
  view
  update
  delete
  manage
}

// Core blob data
model Blob {
  id                  String    @id @db.VarChar(22) // hash(publicKey)[0:16] - URL identifier
  email               String?   @db.VarChar(255)
  publicKeyHash       Bytes     @map("public_key_hash")
  privateKeyHash      Bytes     @map("private_key_hash")
  encryptedPrivateKey String?   @map("encrypted_private_key") @db.Text

  // Encrypted data
  blob        String @db.Text // base64url(encrypted by publicKey)
  privateBlob String @map("private_blob") @db.Text // base64url(encrypted by privateKey)
  sizeBytes   Int    @map("size_bytes")

  // Status
  status BlobStatus @default(active)
  plan   BlobPlan   @default(free)

  // Expiration
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  inactivityDays Int?      @map("inactivity_days")
  maxTotalReads  Int?      @map("max_total_reads")
  maxReadsPerIp  Int?      @map("max_reads_per_ip")
  maxTotalWrites Int?      @map("max_total_writes")
  maxWritesPerIp Int?      @map("max_writes_per_ip")

  // Timestamps
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  suspendedAt    DateTime? @map("suspended_at") @db.Timestamptz
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at") @db.Timestamptz

  // Relations
  rateLimits    BlobRateLimit?
  securityRules BlobSecurityRule?
  accessLogs    BlobAccessLog[]

  @@index([email])
  @@index([status])
  @@map("blobs")
}

// Rate limiting counters
model BlobRateLimit {
  blobId String @id @map("blob_id") @db.VarChar(22)
  blob   Blob   @relation(fields: [blobId], references: [id], onDelete: Cascade)

  // Daily limits
  dailyViewsCount  Int       @default(0) @map("daily_views_count")
  dailyViewsLimit  Int       @default(100) @map("daily_views_limit")
  dailyUpdatesCount Int       @default(0) @map("daily_updates_count")
  dailyUpdatesLimit Int       @default(10) @map("daily_updates_limit")
  dailyResetAt     DateTime? @map("daily_reset_at") @db.Timestamptz

  // Weekly limits
  weeklyViewsCount   Int       @default(0) @map("weekly_views_count")
  weeklyViewsLimit   Int?      @map("weekly_views_limit")
  weeklyUpdatesCount Int       @default(0) @map("weekly_updates_count")
  weeklyUpdatesLimit Int?      @map("weekly_updates_limit")
  weeklyResetAt      DateTime? @map("weekly_reset_at") @db.Timestamptz

  // Monthly limits
  monthlyViewsCount   Int       @default(0) @map("monthly_views_count")
  monthlyViewsLimit   Int?      @map("monthly_views_limit")
  monthlyUpdatesCount Int       @default(0) @map("monthly_updates_count")
  monthlyUpdatesLimit Int?      @map("monthly_updates_limit")
  monthlyResetAt      DateTime? @map("monthly_reset_at") @db.Timestamptz

  // Yearly limits
  yearlyViewsCount   Int       @default(0) @map("yearly_views_count")
  yearlyViewsLimit   Int?      @map("yearly_views_limit")
  yearlyUpdatesCount Int       @default(0) @map("yearly_updates_count")
  yearlyUpdatesLimit Int?      @map("yearly_updates_limit")
  yearlyResetAt      DateTime? @map("yearly_reset_at") @db.Timestamptz

  // Lifetime counters
  lifetimeViewsCount   Int  @default(0) @map("lifetime_views_count")
  lifetimeViewsLimit   Int? @map("lifetime_views_limit")
  lifetimeUpdatesCount Int  @default(0) @map("lifetime_updates_count")
  lifetimeUpdatesLimit Int? @map("lifetime_updates_limit")

  // Burst protection
  burstViewsCount   Int       @default(0) @map("burst_views_count")
  burstViewsLimit   Int       @default(10) @map("burst_views_limit")
  burstUpdatesCount Int       @default(0) @map("burst_updates_count")
  burstUpdatesLimit Int       @default(3) @map("burst_updates_limit")
  burstResetAt      DateTime? @map("burst_reset_at") @db.Timestamptz

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([dailyResetAt])
  @@map("blob_rate_limits")
}

// Security and access control
model BlobSecurityRule {
  blobId            String  @id @map("blob_id") @db.VarChar(22)
  blob              Blob    @relation(fields: [blobId], references: [id], onDelete: Cascade)
  allowPublicAccess Boolean @default(true) @map("allow_public_access")

  // TOTP (2FA)
  totpSecret             String?  @map("totp_secret") @db.VarChar(32)
  totpVerified           Boolean  @default(false) @map("totp_verified")
  totpRequiredForView    Boolean  @default(false) @map("totp_required_for_view")
  totpRequiredForEdit    Boolean  @default(false) @map("totp_required_for_edit")
  totpRequiredForManage  Boolean  @default(false) @map("totp_required_for_manage")

  // Email verification
  email                  String?  @db.VarChar(255)
  emailVerified          Boolean  @default(false) @map("email_verified")
  emailRequiredForView   Boolean  @default(false) @map("email_required_for_view")
  emailRequiredForEdit   Boolean  @default(false) @map("email_required_for_edit")
  emailRequiredForManage Boolean  @default(false) @map("email_required_for_manage")

  // IP restrictions
  ipWhitelist String[] @map("ip_whitelist")
  ipBlacklist String[] @map("ip_blacklist")

  // Expiration policies
  inactivityDays Int?      @map("inactivity_days") @default(30)
  maxTotalReads  Int?      @map("max_total_reads")
  maxTotalWrites Int?      @map("max_total_writes")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz

  // Password protection
  passwordHash    String?  @map("password_hash") @db.Text
  requirePassword Boolean  @default(false) @map("require_password")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("blob_security_rules")
}

// Access audit log
model BlobAccessLog {
  id     BigInt          @id @default(autoincrement())
  blobId String?         @map("blob_id") @db.VarChar(22)
  blob   Blob?           @relation(fields: [blobId], references: [id], onDelete: SetNull)

  operation AccessOperation
  success   Boolean
  errorCode String?         @map("error_code") @db.VarChar(32)

  // Request metadata
  ipAddr      String? @map("ip_addr") @db.Inet
  countryCode String? @map("country_code") @db.VarChar(2)
  userAgent   String? @map("user_agent") @db.Text
  referer     String? @db.Text

  // Performance tracking
  responseTimeMs Int? @map("response_time_ms")
  blobSizeBytes  Int? @map("blob_size_bytes")

  timestamp DateTime @default(now()) @db.Timestamptz

  @@index([blobId, timestamp(sort: Desc)])
  @@index([ipAddr, timestamp(sort: Desc)])
  @@map("blob_access_logs")
}
